{
  "name": "balans",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Fair sides, every week. No-account, no-server team balancer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:protected": "tsc -b && OBFUSCATE=1 vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "lz-string": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.5",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6"
  }
}
