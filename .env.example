# Ads & analytics stay behind flags so the default build is clean and
# globally launch-ready (brief §3.1, §10, §20). Copy to .env to override.

# Cookieless analytics (e.g. Cloudflare Web Analytics token). Empty = off.
VITE_ANALYTICS_TOKEN=

# Ads off by default. Only flip on with a custom domain + certified CMP (brief §10).
# Ads render ONLY when VITE_ADS_ENABLED=true AND a non-empty AdSense client id is set.
VITE_ADS_ENABLED=false
# Your AdSense publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX. Empty = ads stay off.
VITE_ADSENSE_CLIENT=
# Optional fixed ad slot id; empty uses an auto/responsive slot.
VITE_ADSENSE_SLOT=
# Preview placeholder ads without an AdSense account (no script, no network).
# Real ads (VITE_ADS_ENABLED + client id) take priority over this.
VITE_ADS_SAMPLE=false

# Consent banner + Google Consent Mode v2. OFF by default (privacy-first launch).
# When true, a banner shows ONLY to visitors whose region requires it (EEA/UK,
# detected client-side from the browser timezone — no IP/geo server call).
VITE_CONSENT_ENABLED=false
# Optional GA4 measurement id (G-XXXXXXX) for Consent Mode wiring. Empty = no gtag.
VITE_GA_MEASUREMENT_ID=

# Seed a fresh visit with the sample squad (demo/homelab build). OFF by default.
VITE_SEED_SAMPLE=false

# Build-time JS obfuscation (release only). OFF by default for fast, debuggable
# dev/CI builds. `bun run build:protected` sets OBFUSCATE=1. Raises the bar
# against casual reverse-engineering — NOT real protection (client code is
# always readable). See CLAUDE.md "Algorithm protection".
OBFUSCATE=0
